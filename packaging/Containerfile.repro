# Reproducible build of the distributable nkct (static musl x86_64).
#
# Purpose (Chat-Control / client-side-scanning threat model): let anyone rebuild
# the released binary from public source and byte-compare it, so an injected
# on-device scanner in a vendor binary would show up as a hash mismatch. The
# whole environment is pinned:
#   - base image pinned BY DIGEST (rustc 1.96.1, host target x86_64-unknown-linux-musl)
#   - Cargo.lock enforced with --locked
#   - default features only (backend-rustcrypto = pure Rust; no openssl-src /
#     sqlcipher C builds, no gui/mls)
#   - fixed WORKDIR + CARGO_HOME so rustc embeds identical (then remapped) paths
#     (see the [target.x86_64-unknown-linux-musl] section in .cargo/config.toml)
#
# Do not `latest`-pin. Bump the digest and rust-toolchain.toml together.
FROM docker.io/library/rust@sha256:a41f7740f8b45d45795624eec13a8b42263cc700f19f7e4e86e04d3dda08a479

# C toolchain for crates that compile native code on musl (quinn/rustls crypto
# provider, etc.). apk versions are a residual reproducibility variable pinned
# only as tightly as the base image's Alpine repo snapshot — documented in
# REPRODUCIBLE_BUILD.md. build-base pulls a fixed set for this Alpine release.
RUN apk add --no-cache build-base

# Determinism knobs. SOURCE_DATE_EPOCH is honoured by any dep that timestamps;
# Rust itself embeds no build time. CARGO_HOME is already /usr/local/cargo.
ARG SOURCE_DATE_EPOCH=0
# Variant hook: when non-empty, EXTRA_RUSTFLAGS REPLACES the
# [target.x86_64-unknown-linux-musl] rustflags from .cargo/config.toml for this
# build (env beats config in cargo), so a variant MUST restate the full flag
# set including the --remap-path-prefix pair, or reproducibility breaks.
# Empty (the default/portable variant) leaves config.toml in charge.
ARG EXTRA_RUSTFLAGS=""
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    EXTRA_RUSTFLAGS=${EXTRA_RUSTFLAGS} \
    CARGO_INCREMENTAL=0 \
    CARGO_HOME=/usr/local/cargo \
    TZ=UTC \
    LC_ALL=C

WORKDIR /build
COPY . .

# --locked: refuse to build if Cargo.lock would change (deps are still fetched
# from crates.io, whose published tarballs are immutable, so the lock fully
# determines inputs). Not --frozen: that implies --offline and the fresh image
# has no cached registry.
# NOTE: RUSTFLAGS is exported only when EXTRA_RUSTFLAGS is non-empty — an
# empty-but-set RUSTFLAGS would also override config.toml (to nothing).
RUN sh -c 'if [ -n "$EXTRA_RUSTFLAGS" ]; then export RUSTFLAGS="$EXTRA_RUSTFLAGS"; fi; \
        cargo build --release --locked \
            --target x86_64-unknown-linux-musl' \
    && cp target/x86_64-unknown-linux-musl/release/nkct /nkct \
    && sha256sum /nkct
