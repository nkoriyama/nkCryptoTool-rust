# graphify knowledge graph (generated). Rebuild with `/graphify .`; the AST and
# semantic caches under graphify-out/cache/ make a rebuild cheap, and graph.json
# alone is several MB of derived data.
graphify-out/

# Test/runtime artifacts
test_keys/
pqc_keys/
hybrid_keys/
bench_keys/
client_keys*/
server_keys*/
keys_chat/
*.log
test.dec
test_file.txt

# Integration tests write their key material and round-trip files straight into
# tests/ rather than a tempdir, so a plain `cargo test` leaves private keys in
# the worktree. Ignore them: jj auto-tracks anything not listed here, which is
# how they nearly ended up in a commit.
tests/temp_*_keys/
tests/input_*.txt
tests/output_*.enc
# Same hazard, different suite: tests/keybundle_cli.rs hard-codes
# `tests/tmp_kb_*` as its working directories (expired, wrongpin, rawgate,
# keyring, genmykey) and they hold KeyBundle material.
tests/tmp_kb_*/

# Network chat test artifacts
ticket.txt
ticket.log

# Generated UniFFI bindings (regenerate with the uniffi-bindgen bin)
/bindings/
demos/.state/

# Reproducible-build output (the artifact + SHA256SUMS are published per release,
# not committed to the tree)
/packaging/out/
